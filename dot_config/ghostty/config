# Core
clipboard-trim-trailing-spaces = false
shell-integration-features = no-title
window-colorspace = display-p3

# Window
window-padding-x = 12
window-padding-y = 9
window-padding-balance = true
window-inherit-working-directory = true

# Background
background-opacity = 0.94
background-blur = 16

# Theme
theme = Havn Skumring
bold-color = #cdd6f4

# Font
font-family = "Monaspace Neon NF"
font-family-bold = "Monaspace Neon NF"
font-family-italic = "Monaspace Neon NF"
font-family-bold-italic = "Monaspace Neon NF"
font-size = 15
font-thicken = true
font-thicken-strength = 60
font-feature = liga
font-feature = calt
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-shaping-break = cursor
font-codepoint-map = U+4E00-U+9FFF,U+3400-U+4DBF,U+3000-U+303F,U+FF00-U+FFEF=LXGW WenKai Mono

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-color = cell-foreground

# Selection / mouse
selection-clear-on-typing = true
right-click-action = copy-or-paste
mouse-hide-while-typing = true

# macOS
macos-titlebar-style = transparent
macos-icon = custom-style
macos-icon-ghost-color = #a6e3a1
macos-icon-screen-color = #11111b
macos-icon-frame = aluminum

# Keybinds
keybind = ctrl+enter=text:gst\n
keybind = shift+enter=text:\n

# Shader
custom-shader = ./shaders/cursor-matrix.glsl
# custom-shader = ./shaders/bloom.glsl
custom-shader-animation = true
