# Main zsh config
[[ -o interactive ]] || return

# Load modules in order: 00-plugins, 01-env, ..., 07-tools
for _zsh_file in "${ZDOTDIR:-$HOME/.config/zsh}"/[0-9][0-9]-*.zsh(N); do
  source "$_zsh_file"
done
unset _zsh_file

# Machine-specific config (not in repo)
[[ -r "${ZDOTDIR:-$HOME/.config/zsh}/local.zsh" ]] && source "${ZDOTDIR:-$HOME/.config/zsh}/local.zsh"
