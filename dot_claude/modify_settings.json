#!/bin/sh
# Merge the keys below into ~/.claude/settings.json; Claude Code and tools like Orca own everything else (hooks, prompt state).
set -e
current=$(cat)
[ -n "$current" ] || current='{}'
printf '%s' "$current" | jq --indent 2 '. * $managed' --argjson managed "$(cat <<'JSON'
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "autoUpdatesChannel": "latest",
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "mcp-image-viewer@anthropic-plugin-directory": true
  }
}
JSON
)"
