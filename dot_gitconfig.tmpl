# Default identity (the default account, see .chezmoi.toml.tmpl)
[include]
	path = ~/.config/git/accounts/{{ dig "git" "default" "default" . }}.gitconfig

[color]
	ui = true

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	default = current
	followTags = true

[pull]
	rebase = false
	ff = only

[fetch]
	prune = true
	pruneTags = true

[branch]
	sort = -committerdate

[rerere]
	enabled = true
	autoupdate = true

[rebase]
	autoStash = true
	updateRefs = true

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default

[core]
	pager = delta
	editor = zed --wait

[interactive]
	diffFilter = delta --color-only

[delta]
	features = side-by-side line-numbers decorations hyperlinks
	syntax-theme = Dracula
	navigate = true
	dark = true

[delta "side-by-side"]
	side-by-side = true

[delta "line-numbers"]
	line-numbers = true

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold blue
	file-decoration-style = blue ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = blue box

[delta "hyperlinks"]
	hyperlinks = true
	hyperlinks-file-link-format = "file://{path}"

# Per-directory overrides. MUST stay at the end of the file: git uses the last value it reads.
{{- range $name, $a := dig "git" "accounts" dict . }}
{{- if and (index $a "dir") (index $a "email") }}

[includeIf "gitdir:{{ $a.dir }}"]
	path = ~/.config/git/accounts/{{ $name }}.gitconfig
{{- end }}
{{- end }}
